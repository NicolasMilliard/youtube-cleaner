{
  "manifest_version": 3,
  "name": "YouTube Cleaner",
  "version": "0.1.0",
  "description": "Hide distracting YouTube content locally.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["content/content.css"],
      "js": ["content/index.js"],
      "run_at": "document_start"
    }
  ]
}
